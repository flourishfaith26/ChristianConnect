// ChristianConnect — Backend Environment Variables
// Copy this file to .env and fill in your values.
// NEVER commit .env to version control.

# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Frontend URL (for CORS) ──────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Database ─────────────────────────────────────────────────────────────────
# Get a MongoDB Atlas connection string from mongodb.com/atlas
DATABASE_URL=mongodb+srv://user:password@cluster.mongodb.net/christianconnect

# ─── Redis ────────────────────────────────────────────────────────────────────
# Get from: Upstash (upstash.com) for serverless, or local Redis
REDIS_URL=redis://localhost:6379

# ─── Clerk Auth ───────────────────────────────────────────────────────────────
# From: Clerk Dashboard → API Keys
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# ─── OpenAI (text moderation) ─────────────────────────────────────────────────
# From: platform.openai.com → API Keys
OPENAI_API_KEY=sk-...

# ─── Google Cloud Vision (image moderation) ──────────────────────────────────
# From: Google Cloud Console → Credentials
GOOGLE_CLOUD_PROJECT_ID=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=./gcp-credentials.json

# ─── SendGrid (email — parental consent + admin alerts) ──────────────────────
# From: sendgrid.com → Settings → API Keys
SENDGRID_API_KEY=SG....
SENDGRID_FROM_EMAIL=no-reply@christianconnect.app
ADMIN_EMAIL=admin@christianconnect.app

# ─── API.Bible (Scripture reading plans) ─────────────────────────────────────
# Free key from: scripture.api.bible
API_BIBLE_KEY=your-api-bible-key-here

# ─── Firebase Admin (push notifications) ─────────────────────────────────────
# From: Firebase Console → Project Settings → Service Accounts → Generate new private key
# Paste the entire JSON content as a single line (or use a file path approach)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ─── Admin Users ──────────────────────────────────────────────────────────────
# Comma-separated list of Clerk user IDs that have admin access
# Find your user ID in Clerk Dashboard → Users
ADMIN_CLERK_IDS=user_xxxx,user_yyyy

# ─── Persona Identity Verification (Dating Section) ──────────────────────────
# From: withpersona.com → Dashboard → API Keys
# Leave PERSONA_API_KEY blank in development to use the auto-approve dev stub
# Sign up at: https://withpersona.com
PERSONA_API_KEY=persona_sandbox_...
PERSONA_TEMPLATE_ID=itmpl_...
PERSONA_WEBHOOK_SECRET=whsec_...

# Days of chat activity before pre-marriage resources unlock (default: 7)
DATING_RESOURCE_UNLOCK_DAYS=7

# ─── Cloudinary (Stories Media Handling) ──────────────────────────────────────
# From: cloudinary.com → Dashboard → Product Environment Credentials
# Leave blank in development to use the auto-stub dev upload
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

