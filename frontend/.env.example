# Frontend Environment Variables
# Copy this to .env.local and fill in your values

# ─── Clerk ──────────────────────────────────────────────────────────────────
# Get from Clerk Dashboard → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/onboarding
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# ─── Backend API ────────────────────────────────────────────────────────────
# Public backend URL used by real-time connections and as the API proxy fallback.
# Local development: http://localhost:4000. Production: your public backend URL.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Optional private backend URL for the Next.js API proxy/server-side requests.
# BACKEND_INTERNAL_URL=http://backend:4000

# ─── App ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=ChristianConnect
NEXT_PUBLIC_APP_URL=http://localhost:3000
